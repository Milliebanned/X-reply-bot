# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Model used for reply generation. Call /api/models to list the ids this
# key can serve; availability differs between Groq accounts.
#   openai/gpt-oss-120b  - best quality
#   openai/gpt-oss-20b   - faster, smaller
#   qwen/qwen3.8-27b     - mid-size alternative
GROQ_MODEL=openai/gpt-oss-120b

# Backend Server (local development only)
PORT=3000
NODE_ENV=development
