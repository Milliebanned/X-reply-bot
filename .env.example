# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Model used for reply generation. Call /api/models to list the ids this
# key can serve; availability differs between Groq accounts.
#   openai/gpt-oss-20b   - fastest of the usable ones, good enough for replies
#   openai/gpt-oss-120b  - better writing, noticeably slower
#   qwen/qwen3.8-27b     - alternative if the gpt-oss models misbehave
#
# The gpt-oss models reason before answering. They are sent
# reasoning_effort=low, without which they are slow and can spend the whole
# token budget thinking, returning empty content.
GROQ_MODEL=openai/gpt-oss-20b

# Backend Server (local development only)
PORT=3000
NODE_ENV=development
