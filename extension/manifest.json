{
  "manifest_version": 3,
  "name": "X Reply Copilot",
  "version": "0.8.0",
  "description": "AI-powered reply suggestions for X (Twitter)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://xreply-six.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "X Reply Copilot",
    "default_popup": "popup.html"
  }
}
